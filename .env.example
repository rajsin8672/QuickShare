# F Share Environment Configuration Example
# Copy this file to .env and configure your production credentials.

# Server Configuration
PORT=3000
NODE_ENV=development

# Production Canonical Domain / URL for Technical SEO & Sitemaps
# Set this to your verified production domain (e.g., https://fshare.onrender.com or https://fshare.example.com)
SITE_URL=

# Supabase Credentials (Required for cloud PostgreSQL & storage)
# Obtain these from your Supabase Project Settings -> API
SUPABASE_URL=https://your-project-id.supabase.co
# Modern secret key or legacy service_role key (REQUIRED for backend server operations)
SUPABASE_SECRET_KEY=sb_secret_your_secret_key_here
SUPABASE_SERVICE_ROLE_KEY=
# Publishable key
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here
SUPABASE_BUCKET_NAME=shared-files

# Security Secrets
# Strong random secret key used to sign temporary download/verification access tokens
SHARE_TOKEN_SECRET=fshare_super_secret_jwt_hmac_key_min_32_chars_long

# File & Upload Limits
# Maximum size for a single file in bytes (default: 50 MB)
MAX_FILE_SIZE_BYTES=52428800
# Maximum total size for all files in a single share in bytes (default: 100 MB)
MAX_TOTAL_SIZE_BYTES=104857600
# Maximum number of files allowed in a single share (default: 10)
MAX_FILE_COUNT=10

# Supported Content Formats
ALLOWED_IMAGE_FORMATS=jpg,jpeg,png,webp,gif
ALLOWED_VIDEO_FORMATS=mp4,webm,mov
ALLOWED_DOC_FORMATS=pdf,txt,doc,docx

# Share Expiration & Cleanup
# Default expiration in minutes if not specified by user (options: 60, 360, 1440, 4320, 10080)
DEFAULT_EXPIRY_MINUTES=1440
# Scheduled cleanup interval in minutes for removing expired shares and files
CLEANUP_INTERVAL_MINUTES=5
# Secret key to authenticate scheduled cleanup cron requests (/api/cleanup)
CRON_SECRET=fshare_cron_secret_generate_random_32_characters

# Rate Limiting
# Window in milliseconds for general API rate limiting (default: 15 minutes)
RATE_LIMIT_WINDOW_MS=900000
# Max requests per window per IP
RATE_LIMIT_MAX_REQUESTS=100
# Max code guessing attempts per 15 minutes per IP
RATE_LIMIT_CODE_GUESS_MAX=20
# Max upload shares created per hour per IP
RATE_LIMIT_UPLOAD_MAX=25

# CORS Configuration (comma-separated origins allowed in production, or * in dev)
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
