# QuickShare Environment Configuration Example
# Copy this file to .env and provide your actual credentials.

# Server Configuration
PORT=3000
NODE_ENV=development

# Supabase Credentials (Required for cloud database & storage)
# Obtain these from your Supabase Project Settings -> API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-secret-key
SUPABASE_BUCKET_NAME=shared-files

# Security Secrets
# Strong random secret key used to sign temporary download/verification access tokens
SHARE_TOKEN_SECRET=quickshare_super_secret_jwt_hmac_key_min_32_chars_long

# File & Upload Limits
# Maximum size for a single file in bytes (default: 25 MB)
MAX_FILE_SIZE_BYTES=26214400
# Maximum total size for all files in a single share in bytes (default: 50 MB)
MAX_TOTAL_SIZE_BYTES=52428800
# Maximum number of files allowed in a single share (default: 10)
MAX_FILE_COUNT=10

# Share Expiration & Cleanup
# Default expiration in minutes if not specified by user (options: 30, 60, 360, 1440, 10080)
DEFAULT_EXPIRY_MINUTES=30
# Scheduled cleanup interval in minutes for removing expired shares and files
CLEANUP_INTERVAL_MINUTES=15

# Rate Limiting
# Window in milliseconds for general API rate limiting (default: 15 minutes)
RATE_LIMIT_WINDOW_MS=900000
# Max requests per window per IP
RATE_LIMIT_MAX_REQUESTS=100
# Max code guessing attempts per 15 minutes per IP
RATE_LIMIT_CODE_GUESS_MAX=20
# Max upload shares created per hour per IP
RATE_LIMIT_UPLOAD_MAX=25

# CORS Configuration (comma-separated origins allowed in production, or * in dev)
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
